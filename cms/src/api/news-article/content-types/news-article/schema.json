{
  "kind": "collectionType",
  "collectionName": "news_articles",
  "info": {
    "singularName": "news-article",
    "pluralName": "news-articles",
    "displayName": "News Article",
    "description": "Press coverage, grants, announcements, and company milestones"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "category": {
      "type": "enumeration",
      "enum": ["Media", "Press Release", "Announcement", "Regulatory", "Milestone", "Event"],
      "default": "Media",
      "required": true
    },
    "publishedDate": {
      "type": "date",
      "required": true
    },
    "displayDate": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "image": {
      "type": "string"
    },
    "imagePosition": {
      "type": "string"
    },
    "externalUrl": {
      "type": "string"
    },
    "excerpt": {
      "type": "text"
    },
    "paragraphs": {
      "type": "json"
    },
    "content": {
      "type": "richtext"
    }
  }
}
