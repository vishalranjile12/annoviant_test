{
  "kind": "collectionType",
  "collectionName": "blog_posts",
  "info": {
    "singularName": "blog-post",
    "pluralName": "blog-posts",
    "displayName": "Blog Post",
    "description": "Long-form posts authored by the Annoviant team"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "excerpt": {
      "type": "text"
    },
    "body": {
      "type": "richtext"
    },
    "publishedDate": {
      "type": "date",
      "required": true
    },
    "author": {
      "type": "string"
    },
    "authorRole": {
      "type": "string"
    },
    "category": {
      "type": "enumeration",
      "enum": ["Science", "Company", "Regulatory", "Perspective", "Update"],
      "default": "Update",
      "required": true
    },
    "heroImage": {
      "type": "string"
    },
    "seoTitle": {
      "type": "string"
    },
    "seoDescription": {
      "type": "text"
    }
  }
}
