# Server
HOST=0.0.0.0
PORT=1337

# Secrets — generate unique values for each environment
APP_KEYS=replace-me-1,replace-me-2,replace-me-3,replace-me-4
API_TOKEN_SALT=replace-me
ADMIN_JWT_SECRET=replace-me
TRANSFER_TOKEN_SALT=replace-me
JWT_SECRET=replace-me
ENCRYPTION_KEY=replace-me

# Database — local dev uses SQLite by default
# DATABASE_CLIENT=sqlite

# Database — production on Railway (link a PostgreSQL service)
# DATABASE_CLIENT=postgres
# DATABASE_URL=postgresql://user:pass@host:5432/railway
# DATABASE_SSL=true

# CORS — set to your deployed frontend URL
FRONTEND_URL=http://localhost:8080

# Optional admin bootstrap (first deploy only)
# STRAPI_ADMIN_EMAIL=admin@annoviant.com
# STRAPI_ADMIN_PASSWORD=change-me
