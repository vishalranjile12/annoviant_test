# Copy to .env.production (committed, read by the Railway Docker build) or set in the
# Railway dashboard. VITE_* values are inlined into the public client bundle at build time.

# Invitation code investors enter to unlock the briefing room.
VITE_BRIEFING_CODE=your-invite-code-here

# Secure data-room URL the unlocked briefing links to (Docsend / Notion / Drive, etc.).
# Leave empty to fall back to an email-us prompt.
VITE_INVESTOR_DATAROOM_URL=https://your-data-room-url
