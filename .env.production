# Investor Briefing gate. Read at build time by Vite and inlined into the client bundle.
# NOTE: VITE_* values are PUBLIC in the shipped bundle. The invite code is light-touch
# request-gating, not a secret. Real confidentiality must come from the data room's own auth.
# You can override these in the Railway dashboard (Variables) if you prefer.

# Invitation code investors enter to unlock the briefing.
VITE_BRIEFING_CODE=ANV-93C7E2-D87255

# Where "Open the data room" points once unlocked. Leave empty to fall back to an
# email-us prompt. Replace with your Docsend / Notion / Drive data-room URL.
VITE_INVESTOR_DATAROOM_URL=
